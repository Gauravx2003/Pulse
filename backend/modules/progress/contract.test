# Role matrix (tasks 13.5 and 23.1, spec platform/rbac-visibility "Contract test matrix"), run by ContractMatrixTest.
# METHOD /path [json body] => ADMIN (hr@) MANAGER (rahul@, Priya's manager) EMPLOYEE (priya@) PEER (arjun@) MENTOR (sara@) OWNER (sana@)
# Writes send a body that fails validation where the route lets the role in, so no data changes.
GET /api/v1/progress/people/{person:priya@pulse.demo} => 200 200 200 403 403 403
GET /api/v1/progress/people/{person:priya@pulse.demo}/pulse => 200 200 200 403 403 403
# everyone answers their own pulse; a mood out of range fails validation
POST /api/v1/progress/pulse {"mood":9,"workload":3} => 400 400 400 400 400 400
# Team wins are visible to the whole team
GET /api/v1/progress/wins => 200 200 200 200 200 200
