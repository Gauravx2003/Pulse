# Role matrix (tasks 13.5 and 23.1, spec platform/rbac-visibility "Contract test matrix"), run by ContractMatrixTest.
# METHOD /path [json body] => ADMIN (hr@) MANAGER (rahul@, Priya's manager) EMPLOYEE (priya@) PEER (arjun@) MENTOR (sara@) OWNER (sana@)
# Writes send a body that fails validation where the route lets the role in, so no data changes.
GET /api/v1/pull_requests/people/{person:priya@pulse.demo} => 200 200 200 403 403 403
GET /api/v1/pull_requests/team => 200 200 403 403 403 403
# a reviewer may open the pull requests they reviewed (Arjun reviewed Priya's first one)
GET /api/v1/pull_requests/prs/{pr:priya@pulse.demo} => 200 200 200 200 200 404
# a peer who neither wrote nor reviewed it gets the same answer as for a missing pull request
GET /api/v1/pull_requests/prs/{prHidden:priya@pulse.demo} => 200 200 200 404 200 404
GET /api/v1/pull_requests/standard => 200 200 200 200 200 200
