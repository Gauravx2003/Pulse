# Role matrix (task 13.5, spec platform/rbac-visibility "Contract test matrix"), run by Track2ContractTest.
# METHOD /path [json body] => ADMIN (hr@) MANAGER (rahul@, Priya's manager) EMPLOYEE (priya@) PEER (arjun@)
# Writes send a body that fails validation where the route lets the role in, so no data changes.
GET /api/v1/work/people/{person:priya@pulse.demo}/overview => 200 200 200 403
GET /api/v1/work/people/{person:priya@pulse.demo}/work-items?period=s:S42 => 200 200 200 403
# a peer gets the same answer as for a missing issue
GET /api/v1/work/issues/PLAT-2231 => 200 200 200 404
# Nudge is for managers; it is sent once per sender, so both managers get 201
POST /api/v1/work/issues/PLAT-2217/nudge {} => 201 201 403 403
